# Template only. Copy to .env.bm1690 on the BM1690 server.
export CHUNKSCAN_CHIP=bm1690
export CHUNKSCAN_DEVICE_ID=0
export PPL_PROJECT_ROOT=/absolute/path/to/compatible-ppl
export PYTHON_BIN=/absolute/path/to/python
export CHUNKSCAN_DEVICE_RUNTIME_ROOT=/absolute/path/to/real-device-runtime
export CHUNKSCAN_RISCV_TOOLCHAIN_ROOT=/absolute/path/to/riscv-toolchain